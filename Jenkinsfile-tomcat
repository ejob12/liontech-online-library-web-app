pipeline {
    agent any

    tools {
        maven 'maven-3.9.12'
    }

    stages {
        stage('Checkout Code') {
            steps {
                git url: 'https://github.com/ejob12/liontech-online-library-web-app.git'
            }
        }

        stage('Build WAR') {
            steps {
                sh 'mvn clean package'
            }
        }

        stage('SonarQube Analysis') {
            steps {
                withSonarQubeEnv('SonarQube') {
                    // Single-line Maven command avoids newline parsing errors
                    sh 'mvn sonar:sonar -Dsonar.projectKey=online-library-web-app -Dsonar.sources=src -Dsonar.java.binaries=target/classes -Dsonar.host.url=http://<your-sonarqube-server>:9000 -Dsonar.login=<your-sonarqube-token>'
                }
            }
        }

        stage('Publish to Nexus') {
            steps {
                sh 'mvn deploy'
            }
        }

        stage('Deploy to Tomcat') {
            steps {
                deploy adapters: [tomcat9(
                  alternativeDeploymentContext: '',
                  credentialsId: 'tomcat-creds',
                  path: '',
                  url: '98.81.166.55:8009'
                )],
                contextPath: 'online-bookstore-deployment',
                war: 'target/*.war'
            }
        }
    }
}





